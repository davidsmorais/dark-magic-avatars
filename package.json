{
  "name": "@davidsmorais/dark-magic-avatars",
  "version": "0.1.0",
  "description": "Composable SVG wizard avatars for React: 6 bodies, hats, eyes, mouths, staffs and capes, plus a builder UI.",
  "license": "MIT",
  "author": "David Morais <david@davidmorais.com>",
  "homepage": "https://github.com/davidsmorais/dark-magic-avatars#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidsmorais/dark-magic-avatars.git"
  },
  "bugs": "https://github.com/davidsmorais/dark-magic-avatars/issues",
  "keywords": ["avatar", "wizard", "svg", "react", "generator", "identicon"],
  "type": "module",
  "sideEffects": ["*.css"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./builder.css": "./builder.css",
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "builder.css", "README.md", "LICENSE"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
